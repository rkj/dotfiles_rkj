#!/usr/bin/env sh

yabai -m config layout bsp
yabai -m config auto_balance on

yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.7

# Keep space labels (main1..N, left, right), layouts, and window rules in sync
SYNC_SCRIPT="$HOME/.config/yabai/sync-layout.sh"
yabai -m signal --add event=display_added   label="sync_display_add"     action="$SYNC_SCRIPT"
yabai -m signal --add event=display_removed label="sync_display_remove"  action="$SYNC_SCRIPT"
yabai -m signal --add event=space_created   label="sync_space_create"    action="$SYNC_SCRIPT"
yabai -m signal --add event=space_destroyed label="sync_space_destroy"   action="$SYNC_SCRIPT"

if [ -x "$SYNC_SCRIPT" ]; then
  "$SYNC_SCRIPT"
fi
